#!/bin/bash
# One-line setup for a fresh Omarchy machine:
#
#   curl -fsSL https://raw.githubusercontent.com/petrzpav/omarchy-setup/main/bootstrap | bash
#
# Clones (or updates) the repo, applies the shared setup, then hands over to an
# AI agent for the parts that depend on you and your machine.

set -euo pipefail

# Everything is in a function so bash reads the whole script before running it:
# with `curl | bash` the script arrives on stdin, which main switches to the
# terminal (sudo, the agent and its questions need one).
main() {
  local url="${OMARCHY_SETUP_URL:-https://github.com/petrzpav/omarchy-setup.git}"
  local dir="${OMARCHY_SETUP_DIR:-$HOME/.local/share/omarchy-setup}"

  command -v omarchy >/dev/null || { echo "This is for Omarchy (https://omarchy.org)." >&2; exit 1; }
  if [[ ! -t 0 ]] && { true </dev/tty; } 2>/dev/null; then exec </dev/tty; fi

  if [[ -d $dir/.git ]]; then
    echo "Updating $dir"
    git -C "$dir" pull --ff-only
  else
    echo "Cloning into $dir"
    git clone -q "$url" "$dir"
  fi

  "$dir/install"

  echo
  if [[ ! -t 0 ]]; then
    echo "The shared setup is applied. To finish it with an AI agent, open a terminal and run:"
    echo "  cd $dir && claude /setup"
    return 0
  fi

  if command -v claude >/dev/null; then
    echo "Starting Claude Code to finish the setup with you: restoring from an old backup,"
    echo "monitors, keyboard, backups and optional apps. Leave any time with Ctrl+D;"
    echo "run it again later with: cd $dir && claude /setup"
    cd "$dir" && exec claude "/setup"
  fi

  local agent
  agent="$(omarchy-default-agent 2>/dev/null || true)"
  if [[ -n $agent ]] && command -v "$agent" >/dev/null; then
    echo "Starting $agent to finish the setup with you."
    cd "$dir" && exec "$agent" "Read .claude/skills/setup/SKILL.md and follow it."
  fi

  cat <<EOF
The shared setup is applied. To finish with an AI agent, install one and run:

  cd $dir && claude /setup

Or do the rest by hand: see $dir/README.md, section "Finish by hand".
EOF
}

main "$@"
