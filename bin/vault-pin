#!/usr/bin/env python3
"""Unlock the rbw password vault with a short PIN instead of the master password.

The master password is sealed in this laptop's TPM 2.0 chip, protected by the
PIN. The TPM's dictionary-attack lockout stops anyone from guessing the PIN, so
a short one is safe; the sealed blob is useless on any other machine.

  vault-pin setup     seal the master password, choose a PIN, switch rbw over
  vault-pin status    show whether the PIN is set up and the TPM lockout state
  vault-pin remove    forget the sealed password, rbw asks for the master again
  vault-pin pinentry  (internal) the pinentry rbw runs; see vault-pinentry
  vault-pin hold      (internal) keeps a herdr pane open for the prompt

rbw has no PIN support of its own, so `vault-pin pinentry` stands in for its
pinentry: when rbw asks for the master password it asks for the PIN, unseals
the password and hands it to rbw. Anything else (2FA codes, a password rbw
rejected, a wrong PIN three times, a locked-out TPM) goes to the real pinentry.

When rbw runs in herdr, every prompt also opens in a herdr pane below it
(pinentry-curses, or pinentry-tty when the pane is too small for a dialog), so it
shows wherever herdr does: its window, `herdr --remote` on the phone. Below an
agent the pane reports itself as a blocked agent named "vault", so Drover and
the herdr sidebar show it as asking.
The first answer wins, the window or the pane, and the other closes. Without a
herdr agent (the vault-pick key), or if herdr fails, only the window opens.
"""

import json
import os
import queue
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path

HOME = Path.home()
DATA = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "vault-pin"
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "vault-pin"
PUB, PRIV = DATA / "seal.pub", DATA / "seal.priv"
REAL_FILE = DATA / "real-pinentry"
LAST_FILE = STATE / "last"
PINENTRY_WRAPPER = Path(__file__).resolve().with_name("vault-pinentry")
TPM_DEVICE = "/dev/tpmrm0"
DIALOG_ROWS = 14  # pinentry-curses needs about this many rows for the PIN dialog
PIN_TRIES = 3
MIN_PIN = 4
MAX_SECRET = 128  # TPM2 sealed data objects hold at most 128 bytes
CANCELED = "83886179"  # GPG_ERR_CANCELED from pinentry: the user cancelled

TPM_ENV = dict(os.environ, TPM2TOOLS_TCTI=f"device:{TPM_DEVICE}")


class TpmError(Exception):
    pass


class WrongPin(TpmError):
    pass


class Lockout(TpmError):
    pass


# ---------------------------------------------------------------- Assuan bits

def esc(s: str) -> str:
    return s.replace("%", "%25").replace("\r", "%0D").replace("\n", "%0A")


def unesc(s: str) -> str:
    out, i = bytearray(), 0
    b = s.encode()
    while i < len(b):
        if b[i] == 0x25 and i + 2 < len(b):
            out.append(int(b[i + 1:i + 3], 16))
            i += 3
        else:
            out.append(b[i])
            i += 1
    return out.decode(errors="replace")


def real_pinentry() -> str:
    try:
        name = REAL_FILE.read_text().strip()
    except OSError:
        name = ""
    for cand in (name, "pinentry-gnome3", "pinentry"):
        if cand and shutil.which(cand):
            return cand
    sys.exit("vault-pin: no pinentry found")


def die_with_parent():
    # A prompt left open after the wrapper dies would answer nobody.
    try:
        import ctypes
        ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG
    except Exception:
        pass


class Pinentry:
    """A conversation with the real pinentry program."""

    def __init__(self, args=(), program=None, greet=True):
        self.p = subprocess.Popen([program or real_pinentry(), *args], stdin=subprocess.PIPE,
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                  text=True, bufsize=1, preexec_fn=die_with_parent)
        if greet:
            self.read()

    def read(self):
        """Read one reply: (data lines, final OK/ERR line)."""
        data = []
        while True:
            line = self.p.stdout.readline()
            if not line:
                return data, "ERR 83886179 pinentry exited"
            line = line.rstrip("\n")
            if line.startswith("D "):
                data.append(line)
            elif line.startswith(("OK", "ERR")):
                return data, line
            # S (status) and # (comment) lines are skipped

    def cmd(self, line: str):
        self.p.stdin.write(line + "\n")
        return self.read()

    def close(self):
        try:
            self.p.stdin.write("BYE\n")
            self.p.stdin.close()
        except OSError:
            pass
        self.p.wait()

    def kill(self):
        if self.p.poll() is None:
            self.p.terminate()
            try:
                self.p.wait(2)
            except subprocess.TimeoutExpired:
                self.p.kill()


def race(lines, targets, client=None):
    """Ask on every target at once; the first answer wins, the rest close.

    `lines` set the prompt up (SETDESC, SETPROMPT…), `targets` are
    (program, args) pairs. A cancel anywhere counts; a prompt that fails for
    another reason (no display, a closed pane) leaves the question to the
    others. When `client`, the rbw process waiting, is gone, nobody is left to
    answer, so everything closes.
    """
    answers, started = queue.Queue(), []

    def converse(pe):
        data, end = pe.read()
        if end.startswith("OK"):
            for line in lines:
                pe.cmd(line)
            data, end = pe.cmd("GETPIN")
        answers.put((data, end))

    for program, args in targets:
        try:
            pe = Pinentry(args, program, greet=False)
        except OSError:
            continue
        started.append(pe)
        threading.Thread(target=converse, args=(pe,), daemon=True).start()

    result, pending = ([], f"ERR {CANCELED} no pinentry"), len(started)
    try:
        while pending:
            try:
                data, end = answers.get(timeout=1)
            except queue.Empty:
                if client and not alive(client):
                    result = ([], f"ERR {CANCELED} the program asking is gone")
                    break
                continue
            pending -= 1
            result = (data, end)
            if end.startswith("OK") or CANCELED in end:
                break
    finally:
        for pe in started:
            pe.kill()
    return result


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def ask(prompt, desc, error=None, title="Vault", args=(), ui=None):
    """Ask for a secret; None when cancelled."""
    lines = [f"SETTITLE {esc(title)}", f"SETDESC {esc(desc)}", f"SETPROMPT {esc(prompt)}"]
    if error:
        lines.append(f"SETERROR {esc(error)}")
    if ui:
        data, end = ui.ask(lines)
    else:
        data, end = race(lines, [(real_pinentry(), list(args))])
    if not end.startswith("OK"):
        return None
    return unesc("".join(d[2:] for d in data))


# ------------------------------------------------------------------- TPM bits

def tpm(*args, input=None):
    r = subprocess.run(args, env=TPM_ENV, input=input, capture_output=True)
    if r.returncode:
        err = r.stderr.decode(errors="replace")
        low = err.lower()
        if "lockout" in low or "0x921" in low:
            raise Lockout(err)
        if "0x98e" in low or "authorization hmac check failed" in low or "auth_fail" in low:
            raise WrongPin(err)
        raise TpmError(err.strip() or f"{args[0]} failed ({r.returncode})")
    return r.stdout


def tpm_check():
    if not shutil.which("tpm2_unseal"):
        sys.exit("vault-pin: install tpm2-tools first (omarchy pkg add tpm2-tools)")
    if not os.access(TPM_DEVICE, os.R_OK | os.W_OK):
        sys.exit(f"vault-pin: no access to {TPM_DEVICE}; run "
                 f"`sudo usermod -aG tss $USER` and log in again")


def primary(tmp):
    # The same template always derives the same primary key, so nothing about
    # it has to be stored. ECC keeps it fast.
    ctx = f"{tmp}/primary.ctx"
    tpm("tpm2_createprimary", "-Q", "-C", "o", "-G", "ecc256", "-c", ctx)
    return ctx


def runtime_tmp():
    return tempfile.TemporaryDirectory(dir=os.environ.get("XDG_RUNTIME_DIR"))


def seal(secret: bytes, pin: str):
    if len(secret) > MAX_SECRET:
        sys.exit(f"vault-pin: the TPM seals at most {MAX_SECRET} bytes")
    DATA.mkdir(parents=True, exist_ok=True, mode=0o700)
    with runtime_tmp() as tmp:
        pinf = Path(tmp, "pin")
        pinf.write_text(pin)
        pinf.chmod(0o600)
        try:
            tpm("tpm2_create", "-Q", "-C", primary(tmp), "-p", f"file:{pinf}",
                "-u", f"{tmp}/seal.pub", "-r", f"{tmp}/seal.priv", "-i", "-",
                input=secret)
        finally:
            pinf.unlink()
        for src, dst in ((f"{tmp}/seal.pub", PUB), (f"{tmp}/seal.priv", PRIV)):
            shutil.copyfile(src, dst)
            dst.chmod(0o600)


def unseal(pin: str) -> bytes:
    with runtime_tmp() as tmp:
        tpm("tpm2_load", "-Q", "-C", primary(tmp), "-u", str(PUB), "-r", str(PRIV),
            "-c", f"{tmp}/seal.ctx")
        pinf = Path(tmp, "pin")
        pinf.write_text(pin)
        pinf.chmod(0o600)
        try:
            return tpm("tpm2_unseal", "-c", f"{tmp}/seal.ctx", "-p", f"file:{pinf}")
        finally:
            pinf.unlink()


def lockout_info():
    try:
        out = tpm("tpm2_getcap", "properties-variable").decode()
    except TpmError as e:
        return f"unknown ({e})"
    vals = {}
    key = None
    for line in out.splitlines():
        s = line.strip()
        if s.startswith("TPM2_PT_") and s.endswith(":"):
            key = s[:-1]
        elif key and s.startswith("raw:"):
            vals[key] = int(s.split(":", 1)[1], 0)
            key = None
        elif s.startswith("TPM2_PT_") and ":" in s:
            k, v = s.split(":", 1)
            try:
                vals[k] = int(v.strip(), 0)
            except ValueError:
                pass
    tries = vals.get("TPM2_PT_MAX_AUTH_FAIL")
    count = vals.get("TPM2_PT_LOCKOUT_COUNTER")
    interval = vals.get("TPM2_PT_LOCKOUT_INTERVAL")
    if tries is None:
        return "unknown"
    s = f"{count} of {tries} failed tries used"
    if interval:
        s += f", one forgiven every {interval // 60} min" if interval >= 60 else f", one forgiven every {interval} s"
    return s


# ------------------------------------------------------------- herdr bits

def herdr_caller():
    """The waiting rbw client that runs in a herdr pane: (pid, pane, socket).

    rbw-agent starts the pinentry and passes on only a few variables, so the
    pane comes from the rbw client itself; the newest one wins.
    """
    best, uid = None, os.getuid()
    for d in Path("/proc").iterdir():
        if not d.name.isdigit():
            continue
        try:
            if d.stat().st_uid != uid or (d / "comm").read_text().strip() != "rbw":
                continue
            env = dict(kv.split("=", 1) for kv in
                       (d / "environ").read_bytes().decode(errors="replace").split("\0")
                       if "=" in kv)
            start = int((d / "stat").read_text().rsplit(")", 1)[1].split()[19])
        except (OSError, ValueError, IndexError):
            continue
        pane = env.get("HERDR_PANE_ID")
        if pane and (best is None or start > best[0]):
            best = (start, int(d.name), pane, env.get("HERDR_SOCKET_PATH"))
    return best[1:] if best else None


class HerdrPane:
    """A pane below the agent that asked, holding a terminal for pinentry-curses."""

    def __init__(self, pane, socket):
        self.env = dict(os.environ)
        if socket:
            self.env["HERDR_SOCKET_PATH"] = socket
        self.id = None
        caller = self.herdr("pane", "get", pane)["pane"]
        self.agent = (caller.get("label") or caller.get("terminal_title_stripped") or "").strip() \
            or "an agent"
        # Room for the dialog if the caller has it, else at least 40 %.
        rows = caller.get("scroll", {}).get("viewport_rows") or 0
        ratio = min(0.6, 1 - (DIALOG_ROWS + 1) / rows) if rows > 2 * DIALOG_ROWS else 0.6
        made = self.herdr("pane", "split", pane, "--direction", "down", "--ratio", f"{ratio:.2f}")
        self.id = made["pane"]["pane_id"]
        rows = made["pane"].get("scroll", {}).get("viewport_rows") or 0
        self.program = "pinentry-curses" if rows >= DIALOG_ROWS else "pinentry-tty"
        try:
            label = f"Vault PIN · {self.agent}".replace("\n", " ")[:80]
            # The leading space keeps it out of the shell history.
            self.herdr("pane", "run", self.id,
                       f" exec {shlex.quote(str(Path(__file__).resolve()))} hold "
                       f"{shlex.quote(label)} {os.getpid()}")
            # Only below an agent: Drover closes the tab of an agent that ends
            # unless another agent works in it, and a plain shell isn't one.
            if caller.get("agent"):
                self.herdr("pane", "report-agent", self.id, "--source", "vault-pin", "--agent",
                           "vault", "--state", "blocked", "--message", f"PIN for {self.agent}")
            shell = self.herdr("pane", "process-info", "--pane", self.id)["process_info"]["shell_pid"]
            self.tty = os.readlink(f"/proc/{shell}/fd/0")
            # Wait for the shell to become `hold`, so its prompt can't draw over the dialog.
            for _ in range(50):
                if b"hold" in Path(f"/proc/{shell}/cmdline").read_bytes():
                    break
                time.sleep(0.1)
            self.herdr("notification", "show", "Vault PIN", "--body",
                       f"{self.agent} is waiting for the vault PIN", "--sound", "request",
                       check=False)
        except Exception:
            self.close()
            raise

    def herdr(self, *args, check=True):
        r = subprocess.run(["herdr", *args], env=self.env, capture_output=True, text=True,
                           timeout=10)
        try:
            out = json.loads(r.stdout or "{}")
        except ValueError:
            out = {}
        if check and (r.returncode or "error" in out):
            raise RuntimeError(f"herdr {args[0]} {args[1]}: {out.get('error') or r.stderr.strip()}")
        return out.get("result", {})

    def target(self):
        args = ["--ttyname", self.tty, "--ttytype", "xterm-256color"]
        lang = os.environ.get("LC_ALL") or os.environ.get("LC_CTYPE") or os.environ.get("LANG")
        if lang:
            args += ["--lc-ctype", lang]
        return (self.program, args)

    def close(self):
        if self.id:
            self.herdr("pane", "close", self.id, check=False)
            self.id = None


def hold(label, owner=None):
    """Run in the herdr pane: name it and keep its terminal for the prompt.

    Ends, closing the pane, once `owner` (the wrapper) is gone, should it be
    killed before it could close the pane itself.
    """
    sys.stdout.write(f"\033]2;{label}\007\033[H\033[2J")
    sys.stdout.flush()
    while owner is None or alive(owner):
        time.sleep(2)


class PromptUI:
    """Where prompts show: the real pinentry, plus a herdr pane when an agent asks."""

    def __init__(self, args):
        self.args = list(args)
        self.caller = herdr_caller()
        self.pane = None
        self.note = None

    def open(self):
        """Open the herdr pane, once, when an agent in herdr is the one asking."""
        if self.caller and self.pane is None and alive(self.caller[0]):
            try:
                self.pane = HerdrPane(*self.caller[1:])
                self.notify()
            except Exception as e:
                # Fail open: the window alone, as before.
                self.caller = None
                log(f"herdr pane: {e}")

    def ask(self, lines):
        if self.caller and not alive(self.caller[0]):
            return [], f"ERR {CANCELED} the program asking is gone"
        self.open()
        targets = [(real_pinentry(), self.args)]
        if self.pane:
            targets.append(self.pane.target())
        return race(lines, targets, self.caller[0] if self.caller else None)

    def notify(self):
        # A critical notification shows over full-screen windows too.
        r = subprocess.run(["notify-send", "-p", "-a", "Vault", "-u", "critical", "-i",
                            "dialog-password", "Vault PIN",
                            f"{self.pane.agent} is waiting for the vault PIN"],
                           capture_output=True, text=True)
        self.note = r.stdout.strip() or None

    def close(self):
        if self.pane:
            self.pane.close()
            self.pane = None
        if self.note:
            subprocess.run(["gdbus", "call", "--session", "--dest",
                            "org.freedesktop.Notifications", "--object-path",
                            "/org/freedesktop/Notifications", "--method",
                            "org.freedesktop.Notifications.CloseNotification", self.note],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.note = None


def log(msg):
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        with open(STATE / "log", "a") as f:
            f.write(f"{time.strftime('%F %T')} {msg}\n")
    except OSError:
        pass


# ----------------------------------------------------------- pinentry wrapper

def mark(what: str):
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        LAST_FILE.write_text(f"{what} {int(time.time())}\n")
    except OSError:
        pass


def last():
    try:
        what, when = LAST_FILE.read_text().split()
        return what, int(when)
    except (OSError, ValueError):
        return None, 0


def notify(summary, body=""):
    subprocess.run(["notify-send", "-a", "Vault", summary, body],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def wrapper(args):
    """Speak Assuan to rbw-agent; answer master-password requests with the PIN."""
    ui = PromptUI(args)
    try:
        converse(args, ui)
    finally:
        ui.close()


def converse(args, ui):
    out = sys.stdout
    history, opts = [], {}

    def reply(*lines):
        for line in lines:
            out.write(line + "\n")
        out.flush()

    def forward_to_real(extra_desc=None):
        lines = [f"{line}%0A%0A{esc(extra_desc)}" if extra_desc and line.startswith("SETDESC ")
                 else line for line in history]
        data, end = ui.ask(lines)
        reply(*data, end)

    reply("OK vault-pin pinentry")
    for raw in sys.stdin:
        line = raw.rstrip("\n")
        cmd, _, arg = line.partition(" ")
        cmd = cmd.upper()
        if cmd == "BYE":
            reply("OK closing connection")
            return
        if cmd == "GETINFO":
            if arg == "pid":
                reply(f"D {os.getpid()}", "OK")
            elif arg == "version":
                reply("D 1.3.3", "OK")
            else:
                reply("OK")
            continue
        if cmd != "GETPIN":
            history.append(line)
            opts[cmd] = unesc(arg)
            reply("OK")
            continue

        is_master = "master password" in opts.get("SETPROMPT", "").lower()
        sealed = PUB.exists() and PRIV.exists()
        if not (is_master and sealed):
            forward_to_real()
            continue

        if "SETERROR" in opts:
            # rbw rejected what we gave it a moment ago: the master password
            # was changed since `vault-pin setup`.
            what, when = last()
            if what == "provided" and time.time() - when < 120:
                mark("rejected")
                forward_to_real("The password sealed with your PIN no longer works; "
                                "run `vault-pin setup` again.")
            else:
                forward_to_real()
            continue

        if not pin_unlock(ui, reply):
            # Cancelled, wrong PIN too often, or TPM trouble: master password.
            forward_to_real()


def pin_unlock(ui, reply) -> bool:
    error = None
    ui.open()
    who = f"Asked by: {ui.pane.agent}\n" if ui.pane else ""
    for left in range(PIN_TRIES - 1, -1, -1):
        pin = ask("PIN", f"Unlock the vault with your PIN.\n{who}"
                  "(Cancel to type the master password instead.)", error, ui=ui)
        if pin is None:
            return False
        try:
            secret = unseal(pin).decode()
        except WrongPin:
            error = f"Wrong PIN, {left} {'try' if left == 1 else 'tries'} left"
            continue
        except Lockout:
            notify("TPM locked out", "Too many wrong PINs; use the master password for now.")
            return False
        except TpmError as e:
            notify("Vault PIN failed", str(e)[:200])
            return False
        mark("provided")
        reply(f"D {esc(secret)}", "OK")
        return True
    return False


# --------------------------------------------------------------- subcommands

def rbw(*args, check=True):
    return subprocess.run(["rbw", *args], check=check, capture_output=True, text=True)


def setup():
    tpm_check()
    pw = ask("Master password", "Enter your vault master password. It will be sealed "
             "in this laptop's TPM, unlocked only by your PIN.", title="Vault PIN setup")
    if not pw:
        sys.exit("cancelled")
    if ask("Master password", "Enter the master password again.", title="Vault PIN setup") != pw:
        sys.exit("vault-pin: the two master passwords differ")
    error = None
    while True:
        pin = ask("New PIN", f"Choose a PIN (at least {MIN_PIN} characters). The TPM locks "
                  "out after repeated wrong tries.", error, title="Vault PIN setup")
        if pin is None:
            sys.exit("cancelled")
        if len(pin) < MIN_PIN:
            error = f"Too short, at least {MIN_PIN} characters"
            continue
        if ask("New PIN", "Enter the PIN again.", title="Vault PIN setup") != pin:
            error = "The PINs differ, try again"
            continue
        break
    seal(pw.encode(), pin)
    del pw, pin

    cur = json.loads(rbw("config", "show").stdout).get("pinentry") or "pinentry-gnome3"
    if Path(cur).name not in ("vault-pinentry",):
        REAL_FILE.write_text(cur + "\n")
    rbw("config", "set", "pinentry", str(PINENTRY_WRAPPER))
    print(f"Sealed. rbw now uses {PINENTRY_WRAPPER}.")

    print("Testing: locking the vault and unlocking it with your PIN…")
    LAST_FILE.unlink(missing_ok=True)
    # A fresh agent: one started before joining the tss group cannot reach the TPM.
    rbw("stop-agent", check=False)
    r = subprocess.run(["rbw", "unlock"])
    what, _ = last()
    if what == "rejected":
        print("The master password you entered was wrong; nothing is set up.")
        remove(quiet=True)
        sys.exit(1)
    if r.returncode or what != "provided":
        print("Unlock with the PIN did not complete; the PIN stays set up, try "
              "`rbw lock; rbw unlock`.")
        sys.exit(1)
    print(f"Works. TPM lockout: {lockout_info()}.")


def remove(quiet=False):
    real = REAL_FILE.read_text().strip() if REAL_FILE.exists() else "pinentry-gnome3"
    rbw("config", "set", "pinentry", real, check=False)
    for f in (PUB, PRIV, REAL_FILE):
        f.unlink(missing_ok=True)
    if not quiet:
        print(f"Removed. rbw asks for the master password again (pinentry: {real}).")


def status():
    pe = json.loads(rbw("config", "show").stdout).get("pinentry")
    sealed = PUB.exists() and PRIV.exists()
    print(f"PIN set up:     {'yes' if sealed else 'no'}")
    print(f"rbw pinentry:   {pe}")
    if shutil.which("tpm2_getcap") and os.access(TPM_DEVICE, os.R_OK | os.W_OK):
        print(f"TPM lockout:    {lockout_info()}")
    what, when = last()
    if what:
        print(f"Last PIN use:   {what} {time.strftime('%Y-%m-%d %H:%M', time.localtime(when))}")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "pinentry":
        wrapper(sys.argv[2:])
    elif cmd == "hold":
        hold(sys.argv[2] if len(sys.argv) > 2 else "Vault PIN",
             int(sys.argv[3]) if len(sys.argv) > 3 else None)
    elif cmd == "setup":
        setup()
    elif cmd == "remove":
        remove()
    elif cmd == "status":
        status()
    else:
        print(__doc__.strip())
        sys.exit(0 if cmd in ("-h", "--help", "help") else 2)


if __name__ == "__main__":
    main()
