#!/bin/bash
# Pause/resume the active gpu-screen-recorder recording (SIGUSR2 toggles pause).
# The pause state is shown by the screen recording icon in the bar
# (~/.config/omarchy/plugins/petrzpav.indicators/indicators/ScreenRecording.qml).

STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/screenrecord-paused"
pid=$(pgrep -f "^gpu-screen-recorder" | head -1)

if [[ -z $pid ]]; then
  rm -f "$STATE_FILE"
  exit 1
fi

kill -SIGUSR2 "$pid"

if [[ -f $STATE_FILE && $(cat "$STATE_FILE") == "$pid" ]]; then
  rm -f "$STATE_FILE"
else
  echo "$pid" >"$STATE_FILE"
fi

omarchy-shell -q omarchy.indicators refresh
