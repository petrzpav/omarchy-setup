#!/bin/bash
# Maintainer only: keep this repo in step with the maintainer's live config.
#
#   tools/sync                    copy live config into the repo and release it as a hotfix
#   tools/sync --dry-run          show what would change in the repo
#   tools/sync --watch            run forever, syncing once nothing changed for DEBOUNCE seconds
#   tools/sync --install-service  install and start the systemd user service
#   tools/sync --remove-service   stop and remove it
#
# What is shared is listed in SOURCES below, plus the bar layout and packages.txt
# (installed packages minus Omarchy's own and PERSONAL_PACKAGES). Shared Hyprland settings are not
# copied: they live in hypr/team.lua, which the maintainer's hyprland.lua loads
# straight from this repo, so editing it is editing the live config.
#
# Changes are released the Flow way (github.com/internetguru/flow, see CLAUDE.md): a hotfix
# branch from main gets the changes, then Flow releases it as a patch version with changelog
# entries (written by `claude -p`, or generic ones without it), merges it back into dev and
# pushes. The repo then returns to the branch it was on. Before that the diff is checked for
# anything that looks like a credential; if one is found nothing is committed and a
# notification says why.

set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CFG="$HOME/.config"
DEBOUNCE=300 # every sync is a release, so wait until the editing is done
SERVICE=omarchy-setup-sync
PRODUCTION=main

# live path → repo path (folders and files, copied as they are)
SOURCES=(
  "$CFG/omarchy/themes/monokai-pro|themes/monokai-pro"
  "$CFG/omarchy/plugins/petrzpav.indicators|plugins/petrzpav.indicators"
  "$HOME/.local/bin/screenrecord-session|bin/screenrecord-session"
  "$HOME/.local/bin/screenrecord-pause-toggle|bin/screenrecord-pause-toggle"
  "$HOME/.local/bin/app-hide|bin/app-hide"
  "$HOME/.local/bin/app-unhide|bin/app-unhide"
  "$HOME/.local/bin/lid-switch|extras/lid-switch"
  "$HOME/.local/bin/backup-usb|extras/backup/backup-usb"
  "$CFG/omarchy/bar/scripts/backup-progress|extras/backup/backup-progress"
  "$CFG/systemd/user/backup-usb.timer|extras/backup/backup-usb.timer"
)
SHELL_JSON="$CFG/omarchy/shell.json"

# Bar widgets and indicator items that are personal (accounts, hardware,
# scripts that aren't in this repo). They are dropped from shell/bar.json.
PERSONAL_WIDGETS='["backup", "poptavky", "petrzpav.mail", "petrzpav.slack", "petrzpav.trello",
  "omarchy.tailscale", "io.github.thisisgm.omapods"]'
PERSONAL_ITEMS='["RemoteDesktop"]'

# Packages installed on top of Omarchy that are not shared: hardware, accounts,
# system plumbing, and build dependencies that a plugin's own setup installs.
PERSONAL_PACKAGES=(
  omarchy omarchy-keyring omarchy-settings sudo mkinitcpio efibootmgr intel-ucode amd-ucode usbutils
  fprintd libfprint-git tailscale wayvnc
  cmake ninja qt6-connectivity qt6-tools
  qemu-desktop edk2-ovmf
)
OMARCHY_PACKAGES="${OMARCHY_PATH:-/usr/share/omarchy}/install"

DRY=0

log() { echo "$(date '+%F %T') $*"; }
notify() { command -v omarchy-notification-send >/dev/null && omarchy-notification-send "$@" || true; }

export_bar() {
  jq --argjson widgets "$PERSONAL_WIDGETS" --argjson items "$PERSONAL_ITEMS" '
    .bar
    | .layout |= map_values(
        map(select(.id as $id | $widgets | index($id) | not)
            | if .items then .items |= map(select(. as $i | $items | index($i) | not)) else . end))
  ' "$SHELL_JSON"
}

# Explicitly installed packages minus Omarchy's own lists minus PERSONAL_PACKAGES,
# one per line with pacman's description; AUR packages get an "aur:" prefix.
export_packages() {
  local base foreign
  base="$(cat "$OMARCHY_PACKAGES"/*.packages 2>/dev/null | sed 's/#.*//; s/\s.*//' | grep -v '^$'
    printf '%s\n' "${PERSONAL_PACKAGES[@]}")"
  foreign="$(pacman -Qqm)"
  echo "# Packages installed on top of Omarchy. Generated by tools/sync; installed by ./install packages."
  comm -23 <(pacman -Qqe | sort -u) <(sort -u <<<"$base") | while read -r pkg; do
    local desc
    desc="$(pacman -Qi "$pkg" | sed -n 's/^Description *: //p')"
    grep -qxF "$pkg" <<<"$foreign" && pkg="aur:$pkg"
    printf '%-28s # %s\n' "$pkg" "$desc"
  done
}

copy_sources() {
  local entry src dst
  for entry in "${SOURCES[@]}"; do
    src="${entry%%|*}" dst="$REPO/${entry#*|}"
    [[ -e $src ]] || { log "missing, skipped: $src"; continue; }
    if [[ -d $src ]]; then
      rsync -a --delete --exclude '*.bak.*' --exclude '.git' $( ((DRY)) && echo --dry-run -i) "$src/" "$dst/"
    elif ((DRY)); then
      cmp -s "$src" "$dst" || echo "would update ${entry#*|}"
    else
      cp -a "$src" "$dst"
    fi
  done

  local bar
  bar="$(export_bar)"
  if [[ $bar != "$(jq . "$REPO/shell/bar.json")" ]]; then
    if ((DRY)); then echo "would update shell/bar.json"; else printf '%s\n' "$bar" >"$REPO/shell/bar.json"; fi
  fi

  local pkgs
  pkgs="$(export_packages)"
  if [[ $pkgs != "$(cat "$REPO/packages.txt" 2>/dev/null)" ]]; then
    if ((DRY)); then echo "would update packages.txt"; else printf '%s\n' "$pkgs" >"$REPO/packages.txt"; fi
  fi
}

# Refuse to commit anything that looks like a credential.
secrets_in_staged() {
  git -C "$REPO" diff --cached -U0 --no-color |
    grep -E '^\+' |
    grep -nEi 'xox[abprs]-[0-9a-z-]{10,}|gh[pousr]_[0-9a-z]{20,}|github_pat_|sk-[a-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY|(password|passwd|secret|api[_-]?key|token)["'"'"']?\s*[:=]\s*["'"'"']?[^\s"'"'"']{8,}' ||
    return 1
}

# Repo paths sync writes; nothing else in the checkout is ever staged.
synced_paths() {
  local entry path
  for path in $(for entry in "${SOURCES[@]}"; do echo "${entry#*|}"; done) shell/bar.json packages.txt hypr; do
    [[ -e $REPO/$path ]] && echo "$path"
  done
  true
}

# Changelog entries for the staged changes, one "Keyword: sentence." per line, as Flow takes them.
changelog_entries() {
  local diff entries
  diff="$(git diff --cached --no-color)"
  if command -v claude >/dev/null; then
    entries="$(timeout 180 claude -p --model sonnet "Write CHANGELOG.md entries for this change to a shared Omarchy setup (themes, bar, Hyprland keybindings, scripts, packages). Rules: one entry per change, one line each, formatted 'Keyword: sentence.' where Keyword is Added, Changed, Removed or Fixed; write for someone using the setup, in the present tense, starting with the subject, not with 'Fix' or 'Add'; name keys and features as the user sees them; brevity wins. Reply with the entry lines only.

$diff" 2>/dev/null | grep -E '^(Added|Changed|Deprecated|Removed|Fixed|Security): .+' || true)"
    [[ -n $entries ]] && { echo "$entries"; return; }
  fi

  # Without Claude: one generic line per area, packages by name.
  local area pkgs
  for area in $(git diff --cached --name-only | sed 's|/.*||' | sort -u); do
    case $area in
    themes) echo "Changed: The Monokai Pro theme is updated." ;;
    plugins) echo "Changed: The bar indicators are updated." ;;
    bin) echo "Changed: The setup's scripts (screen recording, hiding windows) are updated." ;;
    extras) echo "Changed: The optional extras (lid switch, backups) are updated." ;;
    shell) echo "Changed: The bar layout is updated." ;;
    hypr) echo "Changed: The shared Hyprland settings and keybindings are updated." ;;
    esac
  done
  pkgs="$(git diff --cached -U0 -- packages.txt | sed -n 's/^+\([^+#[:space:]][^[:space:]]*\).*/\1/p' | paste -sd ',' | sed 's/,/, /g')"
  [[ -n $pkgs ]] && echo "Added: Packages $pkgs."
  pkgs="$(git diff --cached -U0 -- packages.txt | sed -n 's/^-\([^-#[:space:]][^[:space:]]*\).*/\1/p' | paste -sd ',' | sed 's/,/, /g')"
  [[ -n $pkgs ]] && echo "Removed: Packages $pkgs."
  true
}

fail() {
  log "$1"
  notify -u critical "omarchy-setup: sync stopped" "$1 See: journalctl --user -u $SERVICE"
  return 1
}

# Move the synced changes onto a Flow hotfix branch, release it with changelog entries
# (merged back into dev by Flow) and push. The checkout ends on the branch it started on.
release_hotfix() {
  cd "$REPO"
  local -a paths
  mapfile -t paths < <(synced_paths)
  git add -A -- "${paths[@]}"
  git diff --cached --quiet && return 0

  if hits="$(secrets_in_staged)"; then
    git reset -q
    log "NOT committed, possible secret:"$'\n'"$hits"
    notify -u critical "omarchy-setup: sync stopped" "A change looks like it contains a secret. Nothing was committed; see: journalctl --user -u $SERVICE"
    return 1
  fi
  # Flow needs a clean checkout: anything else uncommitted is the maintainer's own work.
  if [[ -n "$(git status --porcelain --untracked-files=no -- . "${paths[@]/#/:!}")" ]]; then
    git reset -q
    fail "The repo has uncommitted changes outside the synced files; commit or stash them."
    return 1
  fi

  local entries files branch tag sha
  entries="$(changelog_entries)"
  files="$(git diff --cached --name-only | sed 's|/.*||' | sort -u | paste -sd ' ')"
  branch="$(git branch --show-current)"
  tag="$SERVICE $(date +%s)"

  git stash push -q -m "$tag" -- "${paths[@]}"
  sha="$(git stash list --format='%H %gs' | grep -F "$tag" | cut -d' ' -f1)"
  # The stash holds the only copy of hypr/team.lua edits: on failure keep it and say where.
  local keep="The synced changes are kept in stash $sha (git stash apply $sha)."

  if ! flow --yes --pull >/dev/null; then git checkout -q "$branch"; fail "flow --pull failed. $keep"; return 1; fi
  git checkout -q "$PRODUCTION" || { fail "Can't check out $PRODUCTION. $keep"; return 1; }
  if ! flow --yes hotfix >/dev/null; then git checkout -q "$branch"; fail "flow hotfix failed. $keep"; return 1; fi
  if ! git stash apply -q "$sha"; then
    git reset -q --hard && git checkout -q "$branch"
    fail "The synced changes conflict with $PRODUCTION. $keep"
    return 1
  fi
  git add -A -- "${paths[@]}"
  git commit -q -m "Sync from live config: $files"
  log "committed on $(git branch --show-current): $files"$'\n'"$entries"

  if ! printf '%s\n\n' "$entries" | flow --yes >/dev/null; then
    fail "The hotfix release failed; the repo is left as Flow stopped. $keep"
    return 1
  fi
  git stash drop -q "$(git stash list --format='%gd %gs' | grep -F "$tag" | cut -d' ' -f1)"
  log "released $(git show "$PRODUCTION:VERSION")"
  git checkout -q "$branch"

  if git remote get-url origin >/dev/null 2>&1; then
    flow --push >/dev/null && log "pushed" || { fail "Pushing the release failed."; return 1; }
  fi
}

sync_once() {
  copy_sources
  ((DRY)) && { git -C "$REPO" status --short; return 0; }
  release_hotfix
}

watch() {
  local -a paths=("$SHELL_JSON" "$REPO/hypr" /var/log/pacman.log)
  local entry
  for entry in "${SOURCES[@]}"; do paths+=("${entry%%|*}"); done

  log "watching ${#paths[@]} paths"
  sync_once || true
  while true; do
    # Wait for a change, then for things to settle (editors write several times).
    inotifywait -qq -r -e close_write,create,delete,move "${paths[@]}" 2>/dev/null || sleep 30
    while inotifywait -qq -r -t "$DEBOUNCE" -e close_write,create,delete,move "${paths[@]}" 2>/dev/null; do :; done
    sync_once || true
  done
}

install_service() {
  local unit="$HOME/.config/systemd/user/$SERVICE.service"
  mkdir -p "$(dirname "$unit")"
  cat >"$unit" <<EOF
[Unit]
Description=Keep omarchy-setup repo in step with the live config

[Service]
ExecStart=$REPO/tools/sync --watch
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable --now "$SERVICE"
  echo "Installed $unit. Logs: journalctl --user -u $SERVICE -f"
}

case "${1:-}" in
"") sync_once ;;
-n | --dry-run) DRY=1; sync_once ;;
--watch) watch ;;
--install-service) install_service ;;
--remove-service)
  systemctl --user disable --now "$SERVICE" 2>/dev/null || true
  rm -f "$HOME/.config/systemd/user/$SERVICE.service"
  systemctl --user daemon-reload
  ;;
-h | --help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' ;;
*) echo "unknown option $1 (see --help)" >&2; exit 1 ;;
esac
